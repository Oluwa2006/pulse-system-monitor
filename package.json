{
  "name": "pulse-system-monitor",
  "version": "1.0.0",
  "description": "Lightweight desktop system monitor for tracking CPU, memory, storage, network activity, processes, and system health in real time.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "probe": "node scripts/probe.js",
    "test": "node --test test/*.test.js",
    "icon": "electron scripts/make-icon.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac --arm64 --x64"
  },
  "keywords": [
    "electron",
    "system-monitor",
    "diagnostics",
    "cpu",
    "memory"
  ],
  "license": "MIT",
  "private": true,
  "dependencies": {
    "systeminformation": "^5.33.12"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Malkiel Godson",
  "build": {
    "appId": "com.malkielgodson.pulse",
    "productName": "Pulse",
    "copyright": "Copyright (c) 2026 Malkiel Godson",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": "-",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "${productName} ${version}"
    }
  }
}
